# Anthropic Console で発行したAPIキー(https://console.anthropic.com/settings/keys)
# 派生語の自動提案機能(Claude API呼び出し)にのみ使用します。サーバー側(API Route)でのみ参照され、
# ブラウザ側のコードやクライアントバンドルには含まれません。
ANTHROPIC_API_KEY=

# 省略時は claude-haiku-4-5-20251001 を使用(派生語提案には低コストなモデルで十分なため)
# 精度を上げたい場合は claude-sonnet-5 なども指定できます
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
